# Normalize line endings for all text files
* text=auto eol=lf

# Explicit text types
*.py      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.cfg     text eol=lf
*.sh      text eol=lf
Makefile  text eol=lf
*.ipynb   text eol=lf

# Binary / large artifacts — never diff or normalize
*.sqlite  binary
*.db      binary
*.pptx    binary
*.pdf     binary
*.xlsx    binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.zip     binary
*.csv     text eol=lf
